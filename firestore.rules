rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in [
        "gallerykuns@gmail.com",
        "cybog2004@gmail.com",
        "sylove887@gmail.com"
      ];
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user')
        : "user";
    }

    function isAdmin() {
      return isAdminEmail();
    }

    function isEditor() {
      return signedIn() && roleOf(request.auth.uid) == "editor";
    }

    function canWrite() {
      return isAdmin() || isEditor();
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function validEditionTransition(docId) {
      let counter = getAfter(/databases/$(database)/documents/counters/articles).data;
      let index = request.resource.data.sortIndex;
      return counter.articleId == docId && counter.lastIndex == index
        && counter.lastIndex == get(/databases/$(database)/documents/counters/articles).data.lastIndex + 1
        && index is int && index > 0
        && request.resource.data.editionNo ==
          (index < 10 ? '00' : index < 100 ? '0' : '') + string(index);
    }

    function validArticleIdentity(docId) {
      return request.resource.data.status in ['draft', 'published']
        && (resource.data.status == 'published'
          ? request.resource.data.sortIndex == resource.data.sortIndex
            && request.resource.data.editionNo == resource.data.editionNo
          : (request.resource.data.status != 'published' || validEditionTransition(docId)));
    }

    /* ---------------------------
       ARTICLES
    --------------------------- */
    match /articles/{docId} {
      allow read: if resource.data.status == "published" || canWrite();

      allow create: if canWrite()
        && (request.resource.data.status == "draft"
          || (request.resource.data.status == 'published' && validEditionTransition(docId)))
        && (isAdmin() || request.resource.data.authorEmail == request.auth.token.email);

      allow delete: if isAdmin() || (isEditor() && resource.data.status == 'draft'
        && resource.data.authorEmail == request.auth.token.email);

      allow update: if
        (isAdmin() && validArticleIdentity(docId))
        || (
          isEditor()
          && resource.data.authorEmail == request.auth.token.email
          && request.resource.data.authorEmail == request.auth.token.email
          && validArticleIdentity(docId)
        )
        || (
          resource.data.status == "published"
          && onlyChanges(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.get('views', 0) + 1
        )
        || (
          // A like count moves only together with the reader's own like record.
          resource.data.status == "published"
          && signedIn()
          && onlyChanges(['likes'])
          && request.resource.data.likes is int
          && (
            (request.resource.data.likes == resource.data.get('likes', 0) + 1
              && !exists(/databases/$(database)/documents/articles/$(docId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/articles/$(docId)/likes/$(request.auth.uid)))
            || (request.resource.data.likes == resource.data.get('likes', 0) - 1
              && request.resource.data.likes >= 0
              && exists(/databases/$(database)/documents/articles/$(docId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/articles/$(docId)/likes/$(request.auth.uid)))
          )
        );

      match /likes/{uid} {
        function likesBefore() {
          return get(/databases/$(database)/documents/articles/$(docId)).data.get('likes', 0);
        }
        function likesAfter() {
          return getAfter(/databases/$(database)/documents/articles/$(docId)).data.get('likes', 0);
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && likesAfter() == likesBefore() + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && likesAfter() == likesBefore() - 1;
        allow update: if false;
      }

      match /history/{historyId} {
        function ownsArticle() {
          return canWrite() && (isAdmin()
            || get(/databases/$(database)/documents/articles/$(docId)).data.authorEmail == request.auth.token.email);
        }
        allow read, delete: if ownsArticle();
        allow create: if canWrite()
          && request.resource.data.keys().hasOnly(['version', 'userId', 'authorUid', 'ownerEmail', 'label', 'savedAt', 'snapshot', 'createdAt'])
          && request.resource.data.version == 1
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('authorUid', request.auth.uid) == request.auth.uid
          && request.resource.data.ownerEmail == getAfter(/databases/$(database)/documents/articles/$(docId)).data.authorEmail
          && (isAdmin() || request.resource.data.ownerEmail == request.auth.token.email)
          && request.resource.data.createdAt == request.time
          && request.resource.data.savedAt is int
          && request.resource.data.label is string && request.resource.data.label.size() <= 120
          && request.resource.data.snapshot is map
          && request.resource.data.snapshot.keys().hasOnly(['title', 'subtitle', 'category', 'cover', 'coverMedium', 'contentHTML'])
          && request.resource.data.snapshot.title is string
          && request.resource.data.snapshot.subtitle is string
          && request.resource.data.snapshot.category is string
          && request.resource.data.snapshot.cover is string
          && request.resource.data.snapshot.coverMedium is string
          && request.resource.data.snapshot.contentHTML is string
          && request.resource.data.snapshot.contentHTML.size() <= 700000;
        allow update: if false;
      }
    }

    /* ---------------------------
       ARTICLE SUMMARIES (home cards without the article body)
    --------------------------- */
    match /articleSummaries/{docId} {
      function articleAfter() {
        return getAfter(/databases/$(database)/documents/articles/$(docId)).data;
      }
      allow read: if true;
      allow create, update: if canWrite()
        && existsAfter(/databases/$(database)/documents/articles/$(docId))
        && articleAfter().status == 'published'
        && (isAdmin() || articleAfter().authorEmail == request.auth.token.email)
        && request.resource.data.keys().hasOnly(['editionNo', 'sortIndex', 'title', 'subtitle', 'excerpt', 'category', 'author', 'cover', 'coverMedium', 'coverThumb', 'readMinutes', 'relatedEditionNos', 'updatedAt'])
        && (!('relatedEditionNos' in request.resource.data)
          || (request.resource.data.relatedEditionNos is list && request.resource.data.relatedEditionNos.size() <= 12))
        && request.resource.data.editionNo == articleAfter().editionNo
        && request.resource.data.sortIndex == articleAfter().sortIndex
        && request.resource.data.title == articleAfter().title;
      allow delete: if isAdmin()
        || (canWrite() && (!existsAfter(/databases/$(database)/documents/articles/$(docId))
          || articleAfter().status != 'published'));
    }

    match /counters/articles {
      allow read: if canWrite();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['lastIndex', 'articleId', 'updatedAt'])
        && request.resource.data.lastIndex is int && request.resource.data.lastIndex >= 0;
      allow update: if canWrite()
        && request.resource.data.keys().hasOnly(['lastIndex', 'articleId', 'updatedAt'])
        && request.resource.data.lastIndex is int
        && request.resource.data.lastIndex == resource.data.lastIndex + 1
        && request.resource.data.articleId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.status == 'published'
        && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.sortIndex == request.resource.data.lastIndex
        && (isAdmin() || getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.authorEmail == request.auth.token.email);
      allow delete: if false;
    }

    /* ---------------------------
       CONFIG
    --------------------------- */
    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ---------------------------
       COMMENTS
    --------------------------- */
    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.editionNo is string
        && request.resource.data.editionNo.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.author == request.resource.data.nickname
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.get('authorIsAdmin', false) == isAdmin()
        && request.resource.data.createdAt == request.time
        // Comments are public; never store the commenter's email on them.
        && request.resource.data.keys().hasOnly(['editionNo', 'sortIndex', 'articleTitle', 'articleAuthorEmail', 'text', 'nickname', 'author', 'authorUid', 'authorIsAdmin', 'authorPhotoURL', 'createdAt']);

      allow update: if false;

      allow delete: if signedIn() && (
        isAdmin()
        || (
          ("authorUid" in resource.data)
          && resource.data.authorUid == request.auth.uid
        )
      );
    }

    /* ---------------------------
       POLLS
    --------------------------- */
    match /polls/{pollId} {
      allow read: if true;

      allow create, update: if isAdmin()
        && (
          !("closed" in request.resource.data)
          || request.resource.data.closed is bool
        );

      allow delete: if false;

      match /votes/{uid} {
        allow read: if true;

        allow create: if signedIn()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(uid))
          && request.resource.data.keys().hasOnly(['optionId', 'uid', 'createdAt'])
          && request.resource.data.get('uid', uid) == uid
          && request.resource.data.optionId is string
          && request.resource.data.optionId.size() > 0
          && request.resource.data.optionId.size() <= 64
          && (
            !exists(/databases/$(database)/documents/polls/$(pollId))
            || get(/databases/$(database)/documents/polls/$(pollId)).data.closed != true
          );

        allow update, delete: if false;
      }
    }

    /* ---------------------------
       MASTER STICKERS / ACHIEVEMENTS
    --------------------------- */
    match /stickers/{stickerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /achievements/{achId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ---------------------------
       USERS
    --------------------------- */
    function tierFor(xp) {
      return xp >= 1800 ? 'DIAMOND' : xp >= 900 ? 'PLATINUM' : xp >= 400 ? 'GOLD'
        : xp >= 150 ? 'SILVER' : xp >= 50 ? 'BRONZE' : 'ROOKIE';
    }

    // A counter may stay, or grow by at most `step` per write.
    function stepsBy(key, step) {
      let before = resource.data.get(key, 0);
      let after = request.resource.data.get(key, 0);
      return !(key in request.resource.data)
        || (after is int && after >= before && after <= before + step);
    }

    function validProgressUpdate() {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return onlyChanges([
          "lastActiveAt", "lastVisitDate", "streakCount", "streakUpdatedAt",
          "xp", "level", "tier", "tierLabel", "tierColor",
          "saveUniqueCount", "visitDayCount", "commentCount", "shareCount", "updatedAt"
        ])
        // The largest single award in src/data/xpRules.js is 6.
        && stepsBy('xp', 6)
        && stepsBy('saveUniqueCount', 1)
        && stepsBy('visitDayCount', 1)
        && stepsBy('commentCount', 1)
        && stepsBy('shareCount', 1)
        && (!('streakCount' in after) || after.streakCount == 1 || stepsBy('streakCount', 1))
        && (!changed.hasAny(['level']) || after.level == math.floor(after.get('xp', 0) / 100) + 1)
        && (!changed.hasAny(['tier']) || after.tier == tierFor(after.get('xp', 0)))
        && (!changed.hasAny(['lastVisitDate']) || (after.lastVisitDate is string && after.lastVisitDate.matches('^[0-9]{8}$')));
    }

    // Emails stay off public profiles, except staff whose email is already public as article author.
    function validEmailUpdate(uid) {
      return onlyChanges(['email', 'updatedAt'])
        && (!('email' in request.resource.data)
          || (request.resource.data.email == request.auth.token.email
            && (isAdminEmail() || roleOf(uid) in ['editor', 'admin'])));
    }

    // Admins read every private contact from the user list.
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    match /users/{uid} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == uid
        && !('email' in request.resource.data)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.nicknameChanged == false
        && (
          !("role" in request.resource.data)
          || request.resource.data.role == "user"
        );

      allow update: if
        isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && (
            (
              onlyChanges(['nickname', 'nicknameChanged', 'displayName', 'name', 'updatedAt'])
              &&
              resource.data.nicknameChanged == false
              && request.resource.data.nicknameChanged == true
              && request.resource.data.nickname is string
              && request.resource.data.nickname.size() > 0
              && request.resource.data.nickname.size() <= 20
            )
            || (
              onlyChanges(['photoURL', 'updatedAt'])
              && request.resource.data.photoURL is string
              && request.resource.data.photoURL.size() <= 2048
              && request.resource.data.photoURL.matches('^https://.*$')
            )
            || (
              !('role' in resource.data) && onlyChanges(['role', 'updatedAt'])
              && request.resource.data.role == 'user'
            )
            || validEmailUpdate(uid)
            || validProgressUpdate()
          )
        );

      match /private/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && docId == 'contact'
          && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      allow delete: if false;

      match /xpFlags/{flagId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0;

        allow update, delete: if false;
      }

      match /saved/{editionNo} {
        allow read: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.editionNo is string
          && request.resource.data.editionNo.size() > 0;

        allow delete: if signedIn() && request.auth.uid == uid;

        allow update: if false;
      }

      match /daily/{dayId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['views', 'likes', 'comments', 'votes', 'saves', 'shares', 'updatedAt', 'bucket', 'weekend'])
          && (!("views" in request.resource.data) || request.resource.data.views is number)
          && (!("likes" in request.resource.data) || request.resource.data.likes is number)
          && (!("comments" in request.resource.data) || request.resource.data.comments is number)
          && (!("votes" in request.resource.data) || request.resource.data.votes is number)
          && (!("saves" in request.resource.data) || request.resource.data.saves is number)
          && (!("shares" in request.resource.data) || request.resource.data.shares is number);

        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0;

        allow update, delete: if false;
      }

      match /stickers/{stickerId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        allow create: if
          isAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/users/$(uid)/stickers/$(stickerId))
            && stickerId in ["first_save", "first_comment", "first_share", "poll_voter"]
          );

        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /followers/{fanUid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == fanUid;
        allow delete: if signedIn() && (request.auth.uid == fanUid || isAdmin());
        allow update: if false;
      }

      match /followingEditors/{editorUid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow update: if false;
      }

      match /achievements/{achId} {
        // Counted achievements need the profile counter written in the same transaction.
        function achievementEarned(id) {
          let thresholds = {
            "save_10": ["saveUniqueCount", 10], "save_50": ["saveUniqueCount", 50], "save_100": ["saveUniqueCount", 100],
            "comments_10": ["commentCount", 10], "comments_30": ["commentCount", 30], "comments_100": ["commentCount", 100],
            "shares_5": ["shareCount", 5], "shares_20": ["shareCount", 20],
            "visit_7": ["visitDayCount", 7], "visit_30": ["visitDayCount", 30]
          };
          let progress = getAfter(/databases/$(database)/documents/users/$(uid)).data;
          return id in thresholds && progress.get(thresholds[id][0], 0) >= thresholds[id][1];
        }
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

        allow create: if
          isAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/users/$(uid)/achievements/$(achId))
            && (
              achId in ["ach_first_comment", "ach_first_share", "ach_first_visit", "ach_poll_vote"]
              || achievementEarned(achId)
            )
          );

        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    /* ---------------------------
       UP / UNFRAME PLAYLIST (artifacts)
    --------------------------- */
    match /artifacts/{appId}/users/{uid}/profile/stats {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/users/{uid}/likes/{trackId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /artifacts/{appId}/public_stats/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/tracks/{trackId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/playlists/{playlistId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/site_config/{docId}/{subDocId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/site_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/{document=**} {
      allow read: if true;
    }
  }
}
